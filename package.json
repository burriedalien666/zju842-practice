{
  "name": "zju842-practice",
  "version": "0.5.2",
  "desktopUpdateProtocol": 1,
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test:connection-ui": "node scripts/test-connection-ui.js",
    "videos": "node scripts/manage-videos.js",
    "classify:questions": "node scripts/build-curriculum.js",
    "desktop": "node server/desktop.js",
    "package:desktop": "node scripts/package-desktop.js",
    "test:desktop": "node scripts/test-desktop.js",
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:core": "node --test tests/chapters.test.js tests/interactions.test.js tests/learning-view.test.js tests/papers.test.js tests/review.test.js tests/study.test.js tests/persistence.test.js tests/study-version.test.js",
    "format": "prettier --write src server scripts tests docs README.md index.html vite.config.js",
    "admin:setup": "node --env-file-if-exists=.env scripts/setup-admin.js",
    "import:questions": "node scripts/import-questions.js",
    "import:answers": "node scripts/import-public-answers.js",
    "prepare:updates": "node scripts/prepare-updates.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@libsql/client": "^0.18.0",
    "fastify": "^5.12.4",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "vite": "^7.3.6"
  }
}
