HOST=127.0.0.1
PORT=8843
DATA_DIR=./data
# Set this to the exact HTTPS origin before deploying; required in production.
PUBLIC_ORIGIN=http://127.0.0.1:8843
NODE_ENV=development
# To use Turso, set BOTH values privately; omit BOTH for local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional: only proxy IPs/CIDRs verified for the deployed service.
TRUST_PROXY_CIDRS=
